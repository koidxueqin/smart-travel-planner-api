                  "pm.test(\"Status code is 201\", function () {\r",
                  "  pm.expect(pm.response.code).to.eql(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"API key generated successfully\", function () {\r",
                  "  const jsonData = pm.response.json();\r",
                  "\r",
                  "  pm.expect(jsonData.success).to.eql(true);\r",
                  "  pm.expect(jsonData.data.apiKey).to.exist;\r",
                  "  pm.expect(jsonData.data.expiresAt).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"API key length is between 5 and 10 characters\", function () {\r",
                  "  const jsonData = pm.response.json();\r",
                  "\r",
                  "  pm.expect(jsonData.data.apiKey.length).to.be.within(5, 10);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Save API key to collection variable\", function () {\r",
                  "  const jsonData = pm.response.json();\r",
                  "\r",
                  "  pm.collectionVariables.set(\"apiKey\", jsonData.data.apiKey);\r",
